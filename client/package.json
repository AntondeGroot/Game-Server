{
  "name": "client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "generate": "openapi-generator-cli generate && node scripts/no-check-generated.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint --max-warnings=0",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint:folders": "node scripts/check-folder-sizes.mjs",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "prepare": "[ -n \"$CI\" ] || (cd .. && git config core.hooksPath client/.husky)"
  },
  "private": true,
  "packageManager": "npm@12.2.2",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@openapitools/openapi-generator-cli": "^2.42.2",
    "@vitest/coverage-v8": "^5.1.0",
    "angular-eslint": "22.7.0",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.4",
    "eslint-plugin-sonarjs": "^4.2.2",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.8.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.73.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "basic-ftp": "^6.2.6"
  }
}
