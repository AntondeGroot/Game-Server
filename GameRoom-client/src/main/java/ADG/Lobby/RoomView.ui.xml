<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:room="urn:import:ADG.Lobby">
    <g:HTMLPanel ui:field="root" styleName="roomMainPanel room">
        <div class="room-main">
            <div class="room-header">
                <g:Button ui:field="backToLobbyButton" styleName="room-back-button"/>
                <h1 ui:field="roomTitle" class="room-title"/>
                <g:Button ui:field="menuButton" styleName="room-icon-button"/>
                <g:FocusPanel ui:field="menuBackdrop" visible="false" styleName="room-backdrop room-menu-backdrop"/>
                <g:FlowPanel ui:field="menuPanel" visible="false" styleName="room-menu">
                    <g:FlowPanel ui:field="languageRow" styleName="room-menu-language"/>
                    <g:Button ui:field="leaveRoomButton" styleName="room-menu-item"/>
                    <g:Button ui:field="endGameButton" visible="false" styleName="room-menu-item room-menu-item-danger"/>
                    <g:Button ui:field="deleteRoomButton" visible="false" styleName="room-menu-item room-menu-item-danger"/>
                </g:FlowPanel>
            </div>
            <g:HTMLPanel ui:field="playerPanel" styleName="playerSimulation"/>
            <g:FlowPanel ui:field="gameConfigPanel" styleName="room-card">
                <g:FlowPanel styleName="room-game-row">
                    <g:ListBox ui:field="gameSelectorBox" styleName="room-game-select"/>
                    <g:Button ui:field="optionsButton" styleName="optionsButton"/>
                </g:FlowPanel>
                <g:HTML ui:field="optionsDiffList" styleName="room-options-diff"/>
                <g:HTML ui:field="passwordDisplayLabel" visible="false" styleName="room-password-badge"/>
                <g:FlowPanel ui:field="permissionsPanel" styleName="room-settings">
                    <g:Button ui:field="settingsToggleButton" styleName="room-settings-toggle"/>
                    <g:FlowPanel ui:field="settingsBody" styleName="room-permissions-panel" visible="false">
                        <g:CheckBox ui:field="anyPlayerCanSelectGameCheckbox"/>
                        <g:CheckBox ui:field="anyPlayerCanSetOptionsCheckbox"/>
                        <g:CheckBox ui:field="passwordRequiredCheckbox"/>
                        <g:FlowPanel ui:field="passwordEditPanel" visible="false" styleName="room-password-edit">
                            <g:TextBox ui:field="passwordEditInput" styleName="room-password-input"/>
                            <g:Button ui:field="regeneratePasswordButton" styleName="cancelButton room-password-regen"/>
                        </g:FlowPanel>
                    </g:FlowPanel>
                </g:FlowPanel>
            </g:FlowPanel>
            <div class="room-dock">
                <div class="room-dock-row">
                    <g:Button ui:field="startGameButton" visible="false" stylePrimaryName="confirmButton"/>
                    <g:Button ui:field="rejoinGameButton" visible="false" stylePrimaryName="confirmButton"/>
                    <g:Button ui:field="chatButton" styleName="room-icon-button room-chat-button"/>
                </div>
                <g:Label ui:field="startInfoLabel" styleName="startInfoLabel"/>
                <g:Label ui:field="absentPlayersLabel" visible="false" styleName="room-absent-label"/>
            </div>
        </div>
        <g:FocusPanel ui:field="chatBackdrop" styleName="room-backdrop room-chat-backdrop"/>
        <room:RoomChatPanel ui:field="chatPanel"/>
    </g:HTMLPanel>
</ui:UiBinder>
