{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "timezone": "Europe/Amsterdam",
  "schedule": ["* * * * 6"],
  "extends": [
    "config:recommended"
  ],
  "reviewers": ["AntondeGroot"],
  "packageRules": [
    {
      "description": "Merge non-major updates once the required `ci` check passes; majors stay manual.",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    }
  ]
}
