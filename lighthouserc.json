{
  "ci": {
    "collect": {
      "startServerCommand": "java -jar GameRoom.jar",
      "startServerReadyPattern": "Started Application",
      "url": ["http://localhost:4100/", "http://localhost:4100/next/"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new",
        "skipAudits": ["is-crawlable"]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://localhost:4100/(\\?.*)?$",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.85, "aggregationMethod": "median-run" }],
            "categories:accessibility": ["error", { "minScore": 0.73, "aggregationMethod": "median-run" }],
            "categories:best-practices": ["error", { "minScore": 0.96, "aggregationMethod": "median-run" }],
            "categories:seo": ["error", { "minScore": 0.71, "aggregationMethod": "median-run" }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:4100/next/",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.9, "aggregationMethod": "median-run" }],
            "categories:accessibility": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
            "categories:best-practices": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
            "categories:seo": ["error", { "minScore": 0.86, "aggregationMethod": "median-run" }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lighthouse-reports"
    }
  }
}
